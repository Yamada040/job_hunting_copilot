{
  "name": "job-seeker",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "generate:api": "openapi-typescript backend/api/openapi.yaml -o lib/api/schema.d.ts && prettier --write lib/api/schema.d.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "supabase:signing-key": "test -f supabase/signing_keys.json || (echo '[]' > supabase/signing_keys.json && supabase gen signing-key --algorithm ES256 --append)",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@supabase/ssr": "^0.12.0",
    "@tanstack/react-query": "^5.104.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "framer-motion": "^12.23.26",
    "lucide-react": "^1.55.0",
    "next": "^16.4.2",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.7.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.5"
  },
  "overrides": {
    "postcss": "^8.5.17"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "jsdom": "^29.1.1",
    "lefthook": "^2.2.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.7.4",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
}
